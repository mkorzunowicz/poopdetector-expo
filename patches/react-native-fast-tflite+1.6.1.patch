+jsi::Value TensorflowPlugin::runYoloxPostprocessing(jsi::Runtime& runtime, const jsi::Object& options) {
+  // Extract postprocessing parameters
+  auto gridData = options.getProperty(runtime, "gridData");
+  auto numClasses = options.getProperty(runtime, "numClasses").asNumber();
+  auto netSize = options.getProperty(runtime, "netSize").asNumber();
+  auto confThreshold = options.getProperty(runtime, "confThreshold").asNumber();
+  auto nmsThreshold = options.getProperty(runtime, "nmsThreshold").asNumber();
+  auto skipNMS = options.hasProperty(runtime, "skipNMS") 
+                    ? options.getProperty(runtime, "skipNMS").asBool() 
+                    : false;
+  
+  // Get output tensor data as vector
+  const TfLiteTensor* outputTensor = TfLiteInterpreterGetOutputTensor(_interpreter, 0);
+  auto outputBuffer = getOutputArrayForTensor(runtime, outputTensor);
+  TensorHelpers::updateJSBufferFromTensor(runtime, *outputBuffer, outputTensor);
+  
+  // Convert to byte vector then cast to float*
+  auto tensorBytes = outputBuffer->toVector(runtime);
+  float* tensorPtr = reinterpret_cast<float*>(tensorBytes.data());
+  size_t tensorSize = tensorBytes.size() / sizeof(float);
+  std::vector<float> tensorData(tensorPtr, tensorPtr + tensorSize);
+  
+  // Convert gridData TypedArray to std::vector<float>
+  std::vector<float> gridVec;
+  if (isTypedArray(runtime, gridData.asObject(runtime))) {
+    TypedArrayBase gridArrayBase = getTypedArray(runtime, gridData.asObject(runtime));
+    auto gridBytes = gridArrayBase.toVector(runtime);
+    float* gridPtr = reinterpret_cast<float*>(gridBytes.data());
+    size_t gridSize = gridBytes.size() / sizeof(float);
+    gridVec.assign(gridPtr, gridPtr + gridSize);
+  }
+  
+  // Run postprocessing
+  auto detections = YoloxPostprocessor::postprocess(
+    tensorData,
+    gridVec,
+    static_cast<int>(numClasses),
+    static_cast<int>(netSize),
+    static_cast<float>(confThreshold),
+    static_cast<float>(nmsThreshold),
+    skipNMS
+  );
+  
+  // Convert detections to JSI Array
+  jsi::Array result(runtime, detections.size());
+  for (size_t i = 0; i < detections.size(); i++) {
+    const auto& det = detections[i];
+    jsi::Object obj(runtime);
+    obj.setProperty(runtime, "x1", det.x1);
+    obj.setProperty(runtime, "y1", det.y1);
+    obj.setProperty(runtime, "x2", det.x2);
+    obj.setProperty(runtime, "y2", det.y2);
+    obj.setProperty(runtime, "score", det.score);
+    obj.setProperty(runtime, "classId", det.classId);
+    result.setValueAtIndex(runtime, i, std::move(obj));
+  }
+  
+  return result;
+}

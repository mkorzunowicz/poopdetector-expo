diff --git a/node_modules/react-native-fast-tflite/cpp/YoloxPostprocessor.cpp b/node_modules/react-native-fast-tflite/cpp/YoloxPostprocessor.cpp
new file mode 100644
index 0000000..ee8b212
--- /dev/null
+++ b/node_modules/react-native-fast-tflite/cpp/YoloxPostprocessor.cpp
@@ -0,0 +1,163 @@
+#include "YoloxPostprocessor.h"
+#include <algorithm>
+#include <chrono>
+
+// Fast sigmoid approximation using polynomial
+float YoloxPostprocessor::fastSigmoid(float x) {
+    if (x >= 0) {
+        float z = fastExp(-x);
+        return 1.0f / (1.0f + z);
+    } else {
+        float z = fastExp(x);
+        return z / (1.0f + z);
+    }
+}
+
+// Fast exp approximation using polynomial
+float YoloxPostprocessor::fastExp(float x) {
+    if (x < -10.0f) return 0.0f;
+    if (x > 10.0f) return 22026.465f;
+    
+    // Polynomial approximation
+    x = 1.0f + x / 256.0f;
+    x *= x; x *= x; x *= x; x *= x;
+    x *= x; x *= x; x *= x; x *= x;
+    return x;
+}
+
+// Calculate IoU between two detections
+float YoloxPostprocessor::calcIoU(const Detection& a, const Detection& b) {
+    float interX1 = std::max(a.x1, b.x1);
+    float interY1 = std::max(a.y1, b.y1);
+    float interX2 = std::min(a.x2, b.x2);
+    float interY2 = std::min(a.y2, b.y2);
+    
+    float interWidth = std::max(0.0f, interX2 - interX1);
+    float interHeight = std::max(0.0f, interY2 - interY1);
+    float interArea = interWidth * interHeight;
+    
+    if (interArea == 0.0f) return 0.0f;
+    
+    float areaA = (a.x2 - a.x1) * (a.y2 - a.y1);
+    float areaB = (b.x2 - b.x1) * (b.y2 - b.y1);
+    float unionArea = areaA + areaB - interArea;
+    
+    return interArea / unionArea;
+}
+
+// Apply Non-Maximum Suppression
+void YoloxPostprocessor::applyNMS(std::vector<Detection>& detections, float threshold) {
+    if (detections.empty()) return;
+    
+    // Sort by score (descending)
+    std::sort(detections.begin(), detections.end(),
+              [](const Detection& a, const Detection& b) { return a.score > b.score; });
+    
+    std::vector<bool> suppressed(detections.size(), false);
+    
+    for (size_t i = 0; i < detections.size(); ++i) {
+        if (suppressed[i]) continue;
+        
+        for (size_t j = i + 1; j < detections.size(); ++j) {
+            if (suppressed[j]) continue;
+            
+            float iou = calcIoU(detections[i], detections[j]);
+            if (iou > threshold) {
+                suppressed[j] = true;
+            }
+        }
+    }
+    
+    // Remove suppressed detections
+    std::vector<Detection> result;
+    for (size_t i = 0; i < detections.size(); ++i) {
+        if (!suppressed[i]) {
+            result.push_back(detections[i]);
+        }
+    }
+    
+    detections = std::move(result);
+}
+
+std::vector<Detection> YoloxPostprocessor::postprocess(
+    const std::vector<float>& tensorData,
+    const std::vector<float>& gridData,
+    int numClasses,
+    int netSize,
+    float confThreshold,
+    float nmsThreshold,
+    bool skipNMS
+) {
+    std::vector<Detection> proposals;
+    
+    int numBoxFields = 5; // x, y, w, h, obj_conf
+    int numAnchors = gridData.size() / 3; // Each grid point has x, y, stride
+    
+    // Generate proposals
+    for (int i = 0; i < numAnchors; i++) {
+        int gridIdx = i * 3;
+        float gridX = gridData[gridIdx];
+        float gridY = gridData[gridIdx + 1];
+        float stride = gridData[gridIdx + 2];
+        
+        int tensorIdx = i * (numBoxFields + numClasses);
+        
+        // Get objectness confidence
+        float objConf = fastSigmoid(tensorData[tensorIdx + 4]);
+        
+        if (objConf < confThreshold) continue;
+        
+        // Get box coordinates
+        float dx = fastSigmoid(tensorData[tensorIdx + 0]);
+        float dy = fastSigmoid(tensorData[tensorIdx + 1]);
+        float dw = fastExp(tensorData[tensorIdx + 2]);
+        float dh = fastExp(tensorData[tensorIdx + 3]);
+        
+        float centerX = (gridX + dx) * stride;
+        float centerY = (gridY + dy) * stride;
+        float width = dw * stride;
+        float height = dh * stride;
+        
+        // Get class scores
+        int maxClassId = 0;
+        float maxClassScore = tensorData[tensorIdx + numBoxFields];
+        
+        for (int c = 1; c < numClasses; c++) {
+            float score = tensorData[tensorIdx + numBoxFields + c];
+            if (score > maxClassScore) {
+                maxClassScore = score;
+                maxClassId = c;
+            }
+        }
+        
+        float classConf = fastSigmoid(maxClassScore);
+        float finalScore = objConf * classConf;
+        
+        if (finalScore < confThreshold) continue;
+        
+        // Create detection with NORMALIZED coordinates [0-1]
+        Detection det;
+        det.x1 = (centerX - width / 2.0f) / netSize;
+        det.y1 = (centerY - height / 2.0f) / netSize;
+        det.x2 = (centerX + width / 2.0f) / netSize;
+        det.y2 = (centerY + height / 2.0f) / netSize;
+        det.score = finalScore;
+        det.classId = maxClassId;
+        
+        proposals.push_back(det);
+    }
+    
+    // Apply NMS
+    if (!skipNMS && !proposals.empty()) {
+        applyNMS(proposals, nmsThreshold);
+    }
+    
+    // Limit to top 20 detections
+    if (proposals.size() > 20) {
+        std::sort(proposals.begin(), proposals.end(),
+                  [](const Detection& a, const Detection& b) { return a.score > b.score; });
+        proposals.resize(20);
+    }
+    
+    return proposals;
+}

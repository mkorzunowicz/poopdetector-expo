+#pragma once
+
+#include <vector>
+
+struct Detection {
+    float x1, y1, x2, y2;  // Bounding box coordinates (normalized 0-1)
+    float score;            // Confidence score
+    int label;              // Class label
+};
+
+class YoloxPostprocessor {
+public:
+    // Main postprocessing function
+    static std::vector<Detection> postprocess(
+        const float* tensorData,
+        const float* gridData,
+        int gridSize,
+        int numClasses,
+        int netSize,
+        float confThreshold,
+        float nmsThreshold,
+        bool skipNMS
+    );
+
+private:
+    // Fast approximations
+    static float fastSigmoid(float x);
+    static float fastExp(float x);
+    
+    // NMS helpers
+    static float calcIoU(const Detection& a, const Detection& b);
+    static void applyNMS(std::vector<Detection>& detections, float threshold);
+};

+#pragma once
+
+#include <vector>
+#include <cmath>
+
+struct Detection {
+    float x1;
+    float y1;
+    float x2;
+    float y2;
+    float score;
+    int classId;
+};
+
+class YoloxPostprocessor {
+public:
+    static std::vector<Detection> postprocess(
+        const std::vector<float>& tensorData,
+        const std::vector<float>& gridData,
+        int numClasses,
+        int netSize,
+        float confThreshold,
+        float nmsThreshold,
+        bool skipNMS
+    );
+
+private:
+    static float fastSigmoid(float x);
+    static float fastExp(float x);
+    static float calcIoU(const Detection& a, const Detection& b);
+    static void applyNMS(std::vector<Detection>& detections, float threshold);
+};

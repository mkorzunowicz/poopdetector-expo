+++ b/node_modules/react-native-fast-tflite/cpp/YoloxPostprocessor.cpp
@@ -0,0 +1,163 @@
+#include "YoloxPostprocessor.h"
+#include <algorithm>
+#include <cmath>
+
+// Fast approximations for sigmoid and exp
+float YoloxPostprocessor::fastSigmoid(float x) {
+    // Polynomial approximation: 1 / (1 + exp(-x))
+    // Using rational approximation for speed
+    if (x >= 0) {
+        float z = std::exp(-x);
+        return 1.0f / (1.0f + z);
+    } else {
+        float z = std::exp(x);
+        return z / (1.0f + z);
+    }
+}
+
+float YoloxPostprocessor::fastExp(float x) {
+    // Clamp to prevent overflow
+    x = std::max(-10.0f, std::min(10.0f, x));
+    return std::exp(x);
+}
+
+// Calculate IoU between two detections
+float YoloxPostprocessor::calcIoU(const Detection& a, const Detection& b) {
+    float x1 = std::max(a.x1, b.x1);
+    float y1 = std::max(a.y1, b.y1);
+    float x2 = std::min(a.x2, b.x2);
+    float y2 = std::min(a.y2, b.y2);
+    
+    float intersectWidth = std::max(0.0f, x2 - x1);
+    float intersectHeight = std::max(0.0f, y2 - y1);
+    float intersectArea = intersectWidth * intersectHeight;
+    
+    float areaA = (a.x2 - a.x1) * (a.y2 - a.y1);
+    float areaB = (b.x2 - b.x1) * (b.y2 - b.y1);
+    float unionArea = areaA + areaB - intersectArea;
+    
+    return (unionArea > 0) ? (intersectArea / unionArea) : 0.0f;
+}
+
+// Apply Non-Maximum Suppression
+void YoloxPostprocessor::applyNMS(std::vector<Detection>& detections, float threshold) {
+    if (detections.empty()) return;
+    
+    // Sort by score (descending)
+    std::sort(detections.begin(), detections.end(),
+              [](const Detection& a, const Detection& b) { return a.score > b.score; });
+    
+    std::vector<bool> suppressed(detections.size(), false);
+    
+    for (size_t i = 0; i < detections.size(); ++i) {
+        if (suppressed[i]) continue;
+        
+        for (size_t j = i + 1; j < detections.size(); ++j) {
+            if (suppressed[j]) continue;
+            
+            float iou = calcIoU(detections[i], detections[j]);
+            if (iou > threshold) {
+                suppressed[j] = true;
+            }
+        }
+    }
+    
+    // Remove suppressed detections
+    std::vector<Detection> result;
+    for (size_t i = 0; i < detections.size(); ++i) {
+        if (!suppressed[i]) {
+            result.push_back(detections[i]);
+        }
+    }
+    
+    detections = std::move(result);
+}
+
+// Main postprocessing function
+std::vector<Detection> YoloxPostprocessor::postprocess(
+    const float* tensorData,
+    const float* gridData,
+    int gridSize,
+    int numClasses,
+    int netSize,
+    float confThreshold,
+    float nmsThreshold,
+    bool skipNMS
+) {
+    std::vector<Detection> detections;
+    
+    // Process each grid cell
+    for (int i = 0; i < gridSize; i++) {
+        // Tensor layout: [batch=1, num_anchors, 5+num_classes]
+        // Each anchor has: [x, y, w, h, obj_conf, class_probs...]
+        const float* anchor = &tensorData[i * (5 + numClasses)];
+        
+        // Get grid coordinates
+        float gridX = gridData[i * 2];
+        float gridY = gridData[i * 2 + 1];
+        
+        // Extract raw values
+        float rawX = anchor[0];
+        float rawY = anchor[1];
+        float rawW = anchor[2];
+        float rawH = anchor[3];
+        float rawObjConf = anchor[4];
+        
+        // Apply sigmoid to obj confidence
+        float objConf = fastSigmoid(rawObjConf);
+        
+        // Process each class
+        for (int c = 0; c < numClasses; c++) {
+            float rawClassProb = anchor[5 + c];
+            float classProb = fastSigmoid(rawClassProb);
+            
+            // Final confidence = obj_conf * class_prob
+            float confidence = objConf * classProb;
+            
+            if (confidence < confThreshold) continue;
+            
+            // Decode box coordinates
+            // YoloX uses: center = (raw + grid) * stride, size = exp(raw) * stride
+            // But since we're at feature map level, stride = netSize / gridSize
+            // For 416x416 with 52x52 grid: stride = 8
+            // However, the tensor already contains normalized predictions
+            
+            float centerX = (rawX + gridX);
+            float centerY = (rawY + gridY);
+            float width = fastExp(rawW);
+            float height = fastExp(rawH);
+            
+            // Create detection with normalized coordinates [0-1]
+            Detection det;
+            det.x1 = (centerX - width / 2.0f) / netSize;
+            det.y1 = (centerY - height / 2.0f) / netSize;
+            det.x2 = (centerX + width / 2.0f) / netSize;
+            det.y2 = (centerY + height / 2.0f) / netSize;
+            det.score = confidence;
+            det.label = c;
+            
+            // Clamp coordinates to [0, 1]
+            det.x1 = std::max(0.0f, std::min(1.0f, det.x1));
+            det.y1 = std::max(0.0f, std::min(1.0f, det.y1));
+            det.x2 = std::max(0.0f, std::min(1.0f, det.x2));
+            det.y2 = std::max(0.0f, std::min(1.0f, det.y2));
+            
+            // Validate box
+            if (det.x2 > det.x1 && det.y2 > det.y1) {
+                detections.push_back(det);
+            }
+        }
+    }
+    
+    // Apply NMS if not skipped
+    if (!skipNMS && !detections.empty()) {
+        applyNMS(detections, nmsThreshold);
+    }
+    
+    return detections;
+}

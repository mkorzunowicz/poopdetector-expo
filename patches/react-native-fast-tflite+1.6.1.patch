+jsi::Value TensorflowPlugin::runYoloxPostprocessing(jsi::Runtime& runtime, const jsi::Object& options) {
+  // Get the output tensor buffer (should be Float32Array)
+  auto outputBuffer = getOutputArrayForTensor(runtime, TfLiteInterpreterGetOutputTensor(_interpreter, 0));
+  
+  // Convert TypedArray to float pointer
+  auto tensorBytes = outputBuffer->toVector(runtime);
+  float* tensorPtr = reinterpret_cast<float*>(tensorBytes.data());
+  
+  // Get grid data from options
+  auto gridDataArray = options.getProperty(runtime, "gridData").asObject(runtime).asArray(runtime);
+  size_t gridSize = gridDataArray.size(runtime);
+  std::vector<float> gridData(gridSize);
+  for (size_t i = 0; i < gridSize; i++) {
+    gridData[i] = static_cast<float>(gridDataArray.getValueAtIndex(runtime, i).asNumber());
+  }
+  
+  // Get parameters
+  int numClasses = static_cast<int>(options.getProperty(runtime, "numClasses").asNumber());
+  int netSize = static_cast<int>(options.getProperty(runtime, "netSize").asNumber());
+  float confThreshold = static_cast<float>(options.getProperty(runtime, "confThreshold").asNumber());
+  float nmsThreshold = static_cast<float>(options.getProperty(runtime, "nmsThreshold").asNumber());
+  bool skipNMS = options.getProperty(runtime, "skipNMS").asBool();
+  
+  // Run postprocessing
+  auto detections = YoloxPostprocessor::postprocess(
+    tensorPtr,
+    gridData.data(),
+    gridSize / 2,  // gridData is [x, y] pairs
+    numClasses,
+    netSize,
+    confThreshold,
+    nmsThreshold,
+    skipNMS
+  );
+  
+  // Convert detections to JSI array
+  auto resultArray = jsi::Array(runtime, detections.size());
+  for (size_t i = 0; i < detections.size(); i++) {
+    auto& det = detections[i];
+    auto obj = jsi::Object(runtime);
+    
+    // Create box array [x1, y1, x2, y2]
+    auto box = jsi::Array(runtime, 4);
+    box.setValueAtIndex(runtime, 0, jsi::Value(det.x1));
+    box.setValueAtIndex(runtime, 1, jsi::Value(det.y1));
+    box.setValueAtIndex(runtime, 2, jsi::Value(det.x2));
+    box.setValueAtIndex(runtime, 3, jsi::Value(det.y2));
+    
+    obj.setProperty(runtime, "box", box);
+    obj.setProperty(runtime, "score", jsi::Value(det.score));
+    obj.setProperty(runtime, "label", jsi::Value(det.label));
+    
+    resultArray.setValueAtIndex(runtime, i, obj);
+  }
+  
+  return resultArray;
+}
